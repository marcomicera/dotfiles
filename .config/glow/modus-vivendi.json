{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#ffffff",
    "margin": 1
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "\u2502 "
  },
  "paragraph": {},
  "list": {
    "color": "#ffffff",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "bold": true
  },
  "h1": {
    "prefix": "\u2460 ",
    "color": "#2fafff",
    "background_color": "#12154a",
    "bold": true
  },
  "h2": {
    "prefix": "\u2461 ",
    "color": "#ff6b55",
    "background_color": "#3a0c14",
    "bold": true
  },
  "h3": {
    "prefix": "\u2462 ",
    "color": "#d0bc00",
    "background_color": "#381d0f",
    "bold": true
  },
  "h4": {
    "prefix": "\u2463 ",
    "color": "#44bc44",
    "background_color": "#092f1f",
    "bold": true
  },
  "h5": {
    "prefix": "\u2464 ",
    "color": "#00d3d0",
    "background_color": "#042837",
    "bold": true
  },
  "h6": {
    "prefix": "\u2465 ",
    "color": "#b6a0ff",
    "background_color": "#2f0c3f",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#646464",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "\u2022 "
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "#2fafff"
  },
  "task": {
    "ticked": "[\u2713] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#2fafff",
    "underline": true
  },
  "link_text": {
    "color": "#00d3d0"
  },
  "image": {
    "color": "#2fafff",
    "underline": true
  },
  "image_text": {
    "color": "#00d3d0",
    "format": "Image: {{.text}} \u2192"
  },
  "code": {
    "color": "#44bc44"
  },
  "code_block": {
    "color": "#ff6b55",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#ffffff"
      },
      "error": {
        "color": "#ffffff",
        "background_color": "#ff5f59"
      },
      "comment": {
        "color": "#646464"
      },
      "comment_preproc": {
        "color": "#00d3d0"
      },
      "keyword": {
        "color": "#00d3d0"
      },
      "keyword_reserved": {
        "color": "#00d3d0"
      },
      "keyword_namespace": {
        "color": "#00d3d0"
      },
      "keyword_type": {
        "color": "#2fafff"
      },
      "operator": {
        "color": "#00d3d0"
      },
      "punctuation": {
        "color": "#ffffff"
      },
      "name": {
        "color": "#2fafff"
      },
      "name_builtin": {
        "color": "#2fafff"
      },
      "name_tag": {
        "color": "#00d3d0"
      },
      "name_attribute": {
        "color": "#44bc44"
      },
      "name_class": {
        "color": "#2fafff"
      },
      "name_constant": {
        "color": "#b6a0ff"
      },
      "name_decorator": {
        "color": "#44bc44"
      },
      "name_exception": {},
      "name_function": {
        "color": "#44bc44"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {},
      "literal_date": {},
      "literal_string": {
        "color": "#dfaf7a"
      },
      "literal_string_escape": {
        "color": "#00d3d0"
      },
      "generic_deleted": {
        "color": "#ff5f59"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#44bc44"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#b6a0ff"
      },
      "background": {
        "background_color": "#000000"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n\ud83e\udc36 "
  },
  "html_block": {},
  "html_span": {}
}
