# fzf default options — loaded via FZF_DEFAULT_OPTS_FILE
# https://github.com/junegunn/fzf#customizing-the-look
# Colors: Modus Vivendi (matches Neovim / bat / delta). bg and gutter stay at -1 so
# the terminal background and foreground show through, so both follow the appearance.

--style minimal
--height 95%
--layout reverse
--border
--highlight-line
--preview 'fzf-preview.sh {}'
--preview-window right:50%
--bind 'focus:transform-header:file --brief {}'
--bind 'ctrl-/:toggle-preview'
--color=bg+:#2f447f
--color=bg:-1
--color=border:#c4c4c4
--color=fg:-1
--color=gutter:-1
--color=header:#ff6b55
--color=hl+:#00bcff
--color=hl:#00bcff
--color=info:#989898
--color=marker:#feacd0
--color=pointer:#feacd0
--color=prompt:#00bcff
--color=query:-1:regular
--color=scrollbar:#c4c4c4
--color=separator:#ff6b55
--color=spinner:#feacd0
