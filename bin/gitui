#!/usr/bin/env bash
set -euo pipefail

# Resolve the real gitui binary (skip this wrapper on ~/bin).
path="${PATH//${HOME}\/bin:/}"
path="${path//:${HOME}\/bin/}"
real_gitui="$(PATH="$path" command -v gitui)"

env_args=(-u NO_COLOR COLORTERM=truecolor)
if [[ "${TERM:-}" == xterm-ghostty ]]; then
  # Ghostty's default TERM breaks several TUIs until xterm-ghostty terminfo
  # is available everywhere; xterm-256color is the reliable fallback.
  env_args+=(TERM=xterm-256color)
fi

exec env "${env_args[@]}" "$real_gitui" "$@"
