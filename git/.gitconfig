# Identity and signing
[commit]
	gpgSign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[tag]
	gpgSign = true
[gpg]
	format = ssh
[user]
	name = Marco Micera
[includeIf "gitdir:~/git/personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/.cursor/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/git/work/"]
    path = ~/.gitconfig-work
	
# UI and helpers
[gui]
	pruneduringfetch = true
[help]
	autocorrect = 50
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true

# Ignore
[core]
	excludesFile = ~/.config/git/ignore

# Diff and the Delta pager: https://github.com/dandavison/delta
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default # https://dandavison.github.io/delta/color-moved-support.html
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true # use n and N to move between diff sections
	side-by-side = true
	# Colours follow the macOS appearance. detect-dark-light asks the terminal whether
	# its background is dark or light; `auto` in a style then resolves to delta's own
	# default for that element on that side, and the ansi syntax theme renders from the
	# 16 terminal colours, which are Modus Vivendi in dark and Modus Operandi in light.
	# Note the diff tints are delta's, not Modus's: a gitconfig cannot branch on the
	# appearance, so exact Modus backgrounds would have pinned one side.
	detect-dark-light = auto
	syntax-theme = ansi
	minus-style = syntax auto
	minus-non-emph-style = syntax auto
	minus-emph-style = syntax auto
	minus-empty-line-marker-style = syntax auto
	line-numbers-minus-style = "1"
	plus-style = syntax auto
	plus-non-emph-style = syntax auto
	plus-emph-style = syntax auto
	plus-empty-line-marker-style = syntax auto
	line-numbers-plus-style = "2"
	line-numbers-zero-style = "15"
	file-style = "4" bold
	file-decoration-style = "4" box
	hunk-header-decoration-style = "13" box

# Aliases
[alias]
	b = !git rev-parse --abbrev-ref HEAD
	p = !git push --set-upstream origin $(git b)
	d = !git diff
	s = !git status
	ui = !lazygit
	ll = !git pull
	recent = "for-each-ref --sort=committerdate --format='%(color:green)%(committerdate:iso)%09%(color:blue)%(committerdate:relative)%09%(color:reset)%(refname:short)' refs/heads/"
	m = "!git switch main || git switch master; git pull"

# Colors
[color "diff"]
    meta = yellow
    frag = magenta
    old = red bold
    new = green
    plain = white
[color "branch"]
	current = green bold
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

# Git
[pull]
	rebase = false
[push]
	recurseSubmodules = check
[gc]
	autoDetach = false
