{
    // No welcome page
    "workbench.startupEditor": "none",

    // No release notes
    "update.showReleaseNotes": false,

    // Always trust untrusted files
    "security.workspace.trust.untrustedFiles": "open",

    // Editor
    "editor.fontSize": 12,
    "files.autoSave": "onFocusChange",
    "editor.minimap.enabled": false, // no minimap
    "workbench.editor.enablePreview": false, // always open files in new tabs
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.unicodeHighlight.nonBasicASCII": false,
    "workbench.editor.revealIfOpen": true,
    "editor.accessibilitySupport": "off",
    "breadcrumbs.enabled": true,
    "window.commandCenter": true,

    // Theme
    "window.autoDetectColorScheme": true,
    // "workbench.preferredLightColorTheme": "Light+",
    // "workbench.preferredDarkColorTheme": "Cursor Dark",

    // File explorer
    "files.exclude": { // what to show
      "**/.git": false,
      "**/.svn": false,
      "**/.hg": true,
      "**/CVS": true,
      "**/.DS_Store": true,
      "**/Thumbs.db": true
    },
    "workbench.tree.indent": 20, // indentation
    "explorer.autoReveal": false, // never focus opened files into the file explorer pane

    // PDF viewer
    "pdf-preview.default.sidebar": false,
    "pdf-preview.default.scale": "page-width",

    // SVG: open as text instead of image preview
    // Markdown: open in preview by default
    "workbench.editorAssociations": {
        "*.svg": "default",
        "*.md": "vscode.markdown.preview.editor",
        "*.mdx": "vscode.markdown.preview.editor",
        "*.markdown": "vscode.markdown.preview.editor"
    },

    // Todo Tree
    "todo-tree.regex.regex": "((//|#|<!--|;|/\\*|^|%|\\\\)\\s*($TAGS)\\{*|^\\s*- \\[ \\])",
    "todo-tree.regex.regexCaseSensitive": false,
    "todo-tree.highlights.enabled": true,

    // Icons
    "workbench.iconTheme": "vscode-icons",
    "vsicons.dontShowNewVersionMessage": true,
    
    // Terminal
    "terminal.integrated.defaultProfile.osx": "zsh",
    "terminal.external.osxExec": "iTerm.app",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.fontFamily": "Hack Nerd Font",
    "terminal.integrated.scrollback": 9999,
    "terminal.integrated.defaultLocation": "editor",

    // Shell formatter
    "shellformat.useEditorConfig": true,
    
    // Don't send usage data and errors to Red Hat servers
    "redhat.telemetry.enabled": false,
    
    // Git
    "git.openRepositoryInParentFolders": "always",

    // Laguage-specific
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "makefile.configureOnOpen": false,
    "[python]": {
      "editor.formatOnType": true
    },
    "[terraform]": {
      "editor.formatOnSave": true
    },
    "gopls": {
      "ui.semanticTokens": true,
      "hoverKind": "SynopsisDocumentation", // No/Synopsis/Full, default Synopsis
      "completeUnimported": true,
      "usePlaceholders": true,
      "completionDocumentation": true,
    },

    // Continue
    "continue.enableNextEdit": false,
}
