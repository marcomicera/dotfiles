{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "7",
    "margin": 1
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "\u2502 "
  },
  "paragraph": {},
  "list": {
    "color": "7",
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "bold": true
  },
  "h1": {
    "prefix": "\u2460 ",
    "color": "4",
    "background_color": "8",
    "bold": true
  },
  "h2": {
    "prefix": "\u2461 ",
    "color": "9",
    "background_color": "8",
    "bold": true
  },
  "h3": {
    "prefix": "\u2462 ",
    "color": "3",
    "background_color": "8",
    "bold": true
  },
  "h4": {
    "prefix": "\u2463 ",
    "color": "2",
    "background_color": "8",
    "bold": true
  },
  "h5": {
    "prefix": "\u2464 ",
    "color": "6",
    "background_color": "8",
    "bold": true
  },
  "h6": {
    "prefix": "\u2465 ",
    "color": "13",
    "background_color": "8",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "15",
    "format": "\n--------\n"
  },
  "item": {
    "block_prefix": "\u2022 "
  },
  "enumeration": {
    "block_prefix": ". ",
    "color": "4"
  },
  "task": {
    "ticked": "[\u2713] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "4",
    "underline": true
  },
  "link_text": {
    "color": "6"
  },
  "image": {
    "color": "4",
    "underline": true
  },
  "image_text": {
    "color": "6",
    "format": "Image: {{.text}} \u2192"
  },
  "code": {
    "color": "2"
  },
  "code_block": {
    "color": "9",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "7"
      },
      "error": {
        "color": "7",
        "background_color": "1"
      },
      "comment": {
        "color": "15"
      },
      "comment_preproc": {
        "color": "6"
      },
      "keyword": {
        "color": "6"
      },
      "keyword_reserved": {
        "color": "6"
      },
      "keyword_namespace": {
        "color": "6"
      },
      "keyword_type": {
        "color": "4"
      },
      "operator": {
        "color": "6"
      },
      "punctuation": {
        "color": "7"
      },
      "name": {
        "color": "4"
      },
      "name_builtin": {
        "color": "4"
      },
      "name_tag": {
        "color": "6"
      },
      "name_attribute": {
        "color": "2"
      },
      "name_class": {
        "color": "4"
      },
      "name_constant": {
        "color": "13"
      },
      "name_decorator": {
        "color": "2"
      },
      "name_exception": {},
      "name_function": {
        "color": "2"
      },
      "name_other": {},
      "literal": {},
      "literal_number": {},
      "literal_date": {},
      "literal_string": {
        "color": "11"
      },
      "literal_string_escape": {
        "color": "6"
      },
      "generic_deleted": {
        "color": "1"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "2"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "13"
      },
      "background": {
        "background_color": "0"
      }
    }
  },
  "table": {},
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n\ud83e\udc36 "
  },
  "html_block": {},
  "html_span": {}
}
