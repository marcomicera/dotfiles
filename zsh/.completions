# Source completions from cache or generate on first use. Run refresh-zsh-completions to regenerate.
if [[ "$TERM_PROGRAM" = WarpTerminal ]]; then
	return
fi

ZSH_COMPLETIONS_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions"
mkdir -p "$ZSH_COMPLETIONS_CACHE"

# Usage: _source_completion cache_name "full command that prints zsh completion"
_source_completion() {
	local name="$1" cmd="$2" cache_file="$ZSH_COMPLETIONS_CACHE/_$name"
	if [[ -r "$cache_file" ]]; then
		source "$cache_file"
	elif [[ -n "$cmd" ]]; then
		(eval "$cmd" 2>/dev/null) > "$cache_file" && [[ -s "$cache_file" ]] && source "$cache_file"
	fi
}

# Mise tools aren't on PATH until first prompt (lazy mise init in .zshrc).
_mise_source_completion() {
	local name="$1" tool="$2"
	shift 2
	_source_completion "$name" "mise x -- $tool $*"
}

# Cached: run binary only on cache miss or after refresh-zsh-completions
_source_completion k9s             'k9s completion zsh'
_source_completion stern           'stern --completion zsh'
_source_completion skaffold        'skaffold completion zsh'
_source_completion terraform-docs  'terraform-docs completion zsh'
_source_completion dyff            'dyff completion zsh'
_mise_source_completion helm helm completion zsh
_source_completion glab            'glab completion --shell zsh'
_source_completion argocd          'argocd completion zsh'
_source_completion cilium          'cilium completion zsh'
_source_completion hubble          'hubble completion zsh'
_source_completion mise            'mise completion --quiet zsh'
_source_completion kubectl-neat    'kubectl neat completion zsh'
_source_completion argo			   'argo completion zsh'

# These stay as-is (cheap: just register completer, no heavy binary)
complete -o nospace -C "$(mise which terraform 2>/dev/null)" terraform 2>/dev/null || true
complete -C "$(command -v aws_completer 2>/dev/null)" aws 2>/dev/null || true
complete -o nospace -C "$(mise which terragrunt 2>/dev/null)" terragrunt 2>/dev/null || true
# compdef _remotectl remotectl 2>/dev/null || true

# Refresh all cached completions (run after installing/upgrading tools)
refresh-zsh-completions() {
	local d="${XDG_CACHE_HOME:-$HOME/.cache}/zsh-completions"
	rm -f "$d"/_*
	echo "Completions cache cleared. Restart zsh to regenerate."
}

# Selected match: explicit bg/fg (not reverse). zsh's default ma=7 inverts
# 24-bit colors inconsistently — fine on Down, bright on Up — in Ghostty.
zstyle ':completion:*' list-colors \
  ${(s.:.)LS_COLORS} \
  'ma=0;48;2;45;63;118;38;2;200;211;245'
# fzf-tab: pipe zsh completion (git switch, kubectl, files, ...) through fzf.
# Don't use FZF_DEFAULT_OPTS_FILE here — its file preview/header binds break
# non-file candidates (Aloxaf/fzf-tab#455).
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*:git-checkout:*' sort false
zstyle ':completion:*:git-switch:*' sort false
zstyle ':fzf-tab:*' switch-group '<' '>'
zstyle ':fzf-tab:*' fzf-flags \
  --style=minimal --height=80% --layout=reverse --border --highlight-line \
  --bind=tab:down,btab:up \
  --color=bg+:#2d3f76 --color=bg:-1 --color=border:#589ed7 --color=fg:#c8d3f5 \
  --color=gutter:-1 --color=header:#ff966c --color=hl+:#65bcff --color=hl:#65bcff \
  --color=info:#545c7e --color=marker:#ff007c --color=pointer:#ff007c \
  --color=prompt:#65bcff --color=query:#c8d3f5:regular --color=scrollbar:#589ed7 \
  --color=separator:#ff966c --color=spinner:#ff007c
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'fzf-preview.sh $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'fzf-preview.sh $realpath'
zstyle ':fzf-tab:complete:git-(add|diff|restore):*' fzf-preview 'git diff --color=always $word | delta'
zstyle ':fzf-tab:complete:git-(checkout|switch|branch):*' fzf-preview \
  'git log -n 50 --color=always --date=short --pretty="format:%C(auto)%cd %h%d %s" ${word#remotes/}'
# Reclaim Tab after any other widget binders (fzf, oh-my-zsh).
(( $+functions[enable-fzf-tab] )) && enable-fzf-tab
