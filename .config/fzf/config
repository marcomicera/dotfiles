# fzf default options — loaded via FZF_DEFAULT_OPTS_FILE
# https://github.com/junegunn/fzf#customizing-the-look
# Colors: tokyonight-moon (matches Neovim)

--style minimal
--height 95%
--layout reverse
--border
--highlight-line
--preview 'fzf-preview.sh {}'
--preview-window right:50%
--bind 'focus:transform-header:file --brief {}'
--bind 'ctrl-/:toggle-preview'
--color=bg+:#2d3f76
--color=bg:-1
--color=border:#589ed7
--color=fg:#c8d3f5
--color=gutter:-1
--color=header:#ff966c
--color=hl+:#65bcff
--color=hl:#65bcff
--color=info:#545c7e
--color=marker:#ff007c
--color=pointer:#ff007c
--color=prompt:#65bcff
--color=query:#c8d3f5:regular
--color=scrollbar:#589ed7
--color=separator:#ff966c
--color=spinner:#ff007c
