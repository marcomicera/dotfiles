# Identity and signing
[commit]
	gpgSign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[tag]
	gpgSign = true
[gpg]
	format = ssh
[user]
	name = Marco Micera
[includeIf "gitdir:~/git/personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/.cursor/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/git/work/"]
    path = ~/.gitconfig-work
	
# UI and helpers
[gui]
	pruneduringfetch = true
[help]
	autocorrect = 50
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true

# Ignore
[core]
	excludesFile = ~/.config/git/ignore

# Diff and the Delta pager: https://github.com/dandavison/delta
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default # https://dandavison.github.io/delta/color-moved-support.html
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true # use n and N to move between diff sections
	side-by-side = true
	minus-emph-style = white bold red
	plus-emph-style = white bold green
	file-style = yellow bold none
	file-decoration-style = yellow box
	hunk-header-decoration-style = magenta box

# Aliases
[alias]
	b = !git rev-parse --abbrev-ref HEAD
	p = !git push --set-upstream origin $(git b)
	d = !git diff
	s = !git status
	ui = !gitui
	ll = !git pull
	recent = "for-each-ref --sort=committerdate --format='%(color:green)%(committerdate:iso)%09%(color:blue)%(committerdate:relative)%09%(color:reset)%(refname:short)' refs/heads/"

# Colors
[color "diff"]
    meta = yellow
    frag = magenta
    old = red bold
    new = green
    plain = white
[color "branch"]
	current = green bold
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

# Git
[pull]
	rebase = false
[push]
	recurseSubmodules = check
[gc]
	autoDetach = false
