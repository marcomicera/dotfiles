# fzf default options — loaded via FZF_DEFAULT_OPTS_FILE
# https://github.com/junegunn/fzf#customizing-the-look
# Colours are ANSI indices, not hex, so they come from the terminal palette: Modus
# Vivendi in dark, Modus Operandi in light. -1 is the terminal's own default.
# Modus puts its dim grey on 15, so borders and info text use that.

--style minimal
--height 95%
--layout reverse
--border
--highlight-line
--preview 'fzf-preview.sh {}'
--preview-window right:50%
--bind 'focus:transform-header:file --brief {}'
--bind 'ctrl-/:toggle-preview'
--color=bg+:8
--color=bg:-1
--color=border:15
--color=fg:-1
--color=gutter:-1
--color=header:9
--color=hl+:12
--color=hl:12
--color=info:15
--color=marker:5
--color=pointer:5
--color=prompt:12
--color=query:-1:regular
--color=scrollbar:15
--color=separator:9
--color=spinner:5
