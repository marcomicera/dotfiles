# Identity and signing
[commit]
	gpgSign = true
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
	program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"
[tag]
	gpgSign = true
[gpg]
	format = ssh
[user]
	name = Marco Micera
[includeIf "gitdir:~/git/personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/.cursor/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/git/work/"]
    path = ~/.gitconfig-work
	
# UI and helpers
[gui]
	pruneduringfetch = true
[help]
	autocorrect = 50
[smartgit "submodule"]
	fetchalways = false
	update = true
	initializenew = true

# Ignore
[core]
	excludesFile = ~/.config/git/ignore

# Diff and the Delta pager: https://github.com/dandavison/delta
[merge]
    conflictstyle = diff3
[diff]
    colorMoved = default # https://dandavison.github.io/delta/color-moved-support.html
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true # use n and N to move between diff sections
	side-by-side = true
	# Modus Vivendi (matches Neovim / bat). Generated values come from
	# modus-themes.nvim extras/delta; the file/hunk decorations are ours.
	# syntax-theme reads the Modus tmTheme out of bat's cache, so run
	# `bat cache --build` if diffs come out unhighlighted.
	syntax-theme = modus_vivendi
	minus-style = syntax "#4f1119"
	minus-non-emph-style = syntax "#380a0f"
	minus-emph-style = syntax "#781a1f"
	minus-empty-line-marker-style = syntax "#380a0f"
	line-numbers-minus-style = "#ffbfbf"
	plus-style = syntax "#00381f"
	plus-non-emph-style = syntax "#002910"
	plus-emph-style = syntax "#034f2f"
	plus-empty-line-marker-style = syntax "#002910"
	line-numbers-plus-style = "#a0e0a0"
	line-numbers-zero-style = "#989898"
	file-style = "#2fafff" bold
	file-decoration-style = "#2fafff" box
	hunk-header-decoration-style = "#b6a0ff" box

# Aliases
[alias]
	b = !git rev-parse --abbrev-ref HEAD
	p = !git push --set-upstream origin $(git b)
	d = !git diff
	s = !git status
	ui = !lazygit
	ll = !git pull
	recent = "for-each-ref --sort=committerdate --format='%(color:green)%(committerdate:iso)%09%(color:blue)%(committerdate:relative)%09%(color:reset)%(refname:short)' refs/heads/"
	m = "!git switch main || git switch master; git pull"

# Colors
[color "diff"]
    meta = yellow
    frag = magenta
    old = red bold
    new = green
    plain = white
[color "branch"]
	current = green bold
[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

# Git
[pull]
	rebase = false
[push]
	recurseSubmodules = check
[gc]
	autoDetach = false
